                    className="bg-gradient-to-r from-purple-600 to-pink-600 hover:opacity-90 active:scale-95 text-white font-black py-3.5 rounded-xl text-sm shadow-lg shadow-purple-500/30 transition-all">
                    ✨ Generar con IA
                  </button>
                </div>
