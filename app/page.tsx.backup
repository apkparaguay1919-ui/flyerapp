              <p className="text-2xl font-black text-white">{num}</p>
              <p className="text-gray-500 text-xs mt-0.5">{label}</p>
            </div>
          ))}
        </div>
      </section>

      {/* CINTA DE CELULARES */}
      <div className="relative w-full overflow-hidden py-8 mb-20">
